# Device profile metadata for redmi-ax6-stock-nss
# Sourced by GitHub Actions workflows and repository validation scripts.

DEVICE_NAME="redmi-ax6-stock-nss"
DEVICE_TITLE="Redmi AX6 (Stock Layout / LibWrt NSS)"

# Upstream source selection (LiBwrt v25.12.2 with full Qualcomm NSS offload)
UPSTREAM_FLAVOR="libwrt"
UPSTREAM_REPO="https://github.com/LiBwrt/LibWrt.git"
UPSTREAM_REF="v25.12.2"

# Output path under openwrt/bin/targets/ and firmware file matching glob
# Matches both *-squashfs-factory.ubi and *-squashfs-sysupgrade.bin
TARGET_DIR="qualcommax/ipq807x"
ARTIFACT_GLOB="*redmi_ax6-stock-squashfs-*"

# Package manager used by the target baseline ("apk" for 25.12+, "opkg" for legacy)
PKG_MANAGER="apk"

# Default LAN IPv4 address (overridable via workflow input lan_ip)
DEFAULT_LAN_IP="192.168.10.1"
