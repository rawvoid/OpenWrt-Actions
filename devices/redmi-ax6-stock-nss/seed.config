# ==============================================================================
# LibWrt v25.12.2 (Qualcomm NSS) Seed Config for devices/redmi-ax6-stock-nss
# Target hardware: Redmi Router AX6 (Qualcomm IPQ8071A, 4x Cortex-A53 1.4GHz,
#                  512 MiB RAM, 128 MiB NAND, QCN5024 2.4G + QCN5054 5G Wi-Fi 6)
# Partition layout: Stock dual-partition layout (35.75 MiB active rootfs/rootfs_1)
# Hardware offload: Full Qualcomm NSS (NAT/PPPoE/Bridge/VLAN/Wi-Fi + NSS SQM)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Platform & Image Output (Stock Layout SquashFS UBI + Sysupgrade)
# ------------------------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
# Explicitly forbid OpenWrt expand-layout image to prevent layout mismatch bricks
# CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set

CONFIG_TARGET_ROOTFS_SQUASHFS=y
# Disable unused image formats to speed up builds and keep output clean
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# ------------------------------------------------------------------------------
# 2. Toolchain & Compiler Optimization (Cortex-A53 + ARMv8 CRC/Crypto, -Os)
# ------------------------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_CCACHE=y
# Keep -Os for compact 35.75 MiB stock NAND footprint while enabling ARMv8 CRC/AES/SHA
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53+crc+crypto"

# Prevent apk distfeeds.list from referencing non-public custom NSS feed URLs
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set

# ------------------------------------------------------------------------------
# 3. Qualcomm NSS Engine, 512 MiB Memory Profiles & Wi-Fi 6 Offload
# ------------------------------------------------------------------------------
# CRITICAL: IPQ807x defaults to 1GB NSS profile; Redmi AX6 has 512 MiB RAM!
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# CONFIG_NSS_MEM_PROFILE_HIGH is not set
# CONFIG_NSS_MEM_PROFILE_LOW is not set

CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
# CONFIG_ATH11K_MEM_PROFILE_1G is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y

CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax6=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y

# Strip unused LiBwrt qualcommax defaults (AX6 has no USB, eMMC/SD, PCIe Wi-Fi, or 10G PHY)
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_losetup is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_f2fs-tools is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-f2fs is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-phy-aquantia is not set

# ------------------------------------------------------------------------------
# 4. PPPoE & IPv6 Stack
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ------------------------------------------------------------------------------
# 5. Primary Router Plugins & Features
# ------------------------------------------------------------------------------
# UPnP (strictly nftables backend, forbid iptables backend)
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# Dynamic DNS (ddns-scripts + Aliyun + Cloudflare; omit bind-host to save ~1.45 MiB)
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_openssl-util=y
# CONFIG_PACKAGE_bind-host is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set

# Wake-on-LAN
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# KMS Server
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# SQM for NSS (use nss-zk.qos / nssfq_codel in LuCI SQM instead of standard CAKE)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts-nss=y
# CONFIG_PACKAGE_iptables-zz-legacy is not set

# Watchcat (unattended WAN / connectivity watchdog)
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y

# WireGuard VPN (UI translations are bundled into luci-i18n-base-zh-cn in 25.12)
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ZeroTier
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# Bandwidth & Traffic Monitor
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# Static ARP Binding
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y

# Explicitly excluded optional plugins
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_socat is not set
# CONFIG_PACKAGE_luci-app-usteer is not set
# CONFIG_PACKAGE_dawn is not set

# ------------------------------------------------------------------------------
# 6. LuCI Web Interface, HTTPS & Default Bootstrap Theme (No Argon)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ------------------------------------------------------------------------------
# 7. Operations & Diagnostic Utilities
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set

# Compact Vim without 11.5 MiB vim-runtime; omit redundant nano
CONFIG_PACKAGE_vim=y
# CONFIG_PACKAGE_vim-full is not set
# CONFIG_PACKAGE_vim-fuller is not set
# CONFIG_PACKAGE_vim-runtime is not set
# CONFIG_PACKAGE_nano is not set
