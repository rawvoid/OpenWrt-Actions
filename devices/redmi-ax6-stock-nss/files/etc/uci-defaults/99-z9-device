#!/bin/sh
# Device-specific first-boot configuration for redmi-ax6-stock-nss.
# Runs after 99-default-settings* and 99-z0-common.
# Per Qualcomm NSS guidelines, Packet Steering and kernel Flow Offloading MUST
# remain disabled so NSS ECM + Wi-Fi Offload handle forwarding without conflict.

if uci -q get network.globals >/dev/null 2>&1 || uci -q set network.globals=globals; then
  uci -q set network.globals.packet_steering='0'
  uci -q commit network 2>/dev/null || true
fi

if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
  uci -q set firewall.@defaults[0].flow_offloading='0'
  uci -q set firewall.@defaults[0].flow_offloading_hw='0'
  uci -q commit firewall 2>/dev/null || true
fi

# Prevent 99-default-settings from re-enabling packet_steering if re-run.
if uci -q get system.@imm_init[0] >/dev/null 2>&1; then
  uci -q set system.@imm_init[0].packet_steering='1'
  uci -q commit system 2>/dev/null || true
fi

if [ -x /etc/init.d/packet_steering ]; then
  /etc/init.d/packet_steering disable 2>/dev/null || true
fi

exit 0
