# ==============================================================================
# ImmortalWrt v25.12.2 Self-Contained Seed Config for devices/n3160-i210
# Target hardware: Intel Celeron N3160 (Braswell/Airmont, 4C4T, AES-NI, NO AVX)
#                  4GB RAM, Intel I210 (kmod-igb), Pure Wired Router (No Wi-Fi)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Platform & Image Output (UEFI SquashFS Only)
# ------------------------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y

# [Customizable] Root filesystem partition size in MiB (default: 512)
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# Disable non-UEFI / VM / live-ISO image formats
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_GRUB_IMAGES is not set
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ------------------------------------------------------------------------------
# 2. Toolchain & Compiler Optimization (Braswell / Airmont)
# ------------------------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_CCACHE=y
# N3160 supports SSE4.1/4.2, AES-NI, PCLMULQDQ; does NOT support AVX/AVX2.
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=silvermont -maes -mpclmul"

# ------------------------------------------------------------------------------
# 3. Hardware Drivers, Kernel Modules & Crypto
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-itco-wdt=y
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_kmod-hwmon-coretemp=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_pciutils=y

# Use ethtool-full and explicitly disable tiny ethtool (CONFLICTS in v25.12.2)
CONFIG_PACKAGE_ethtool-full=y
# CONFIG_PACKAGE_ethtool is not set

# Note: AES and AES-NI are built directly into x86/64 kernel 6.12
# (CONFIG_CRYPTO_AES=y, CONFIG_CRYPTO_AES_NI_INTEL=y); kmod-crypto-aes and
# kmod-crypto-x86 do not exist as separate packages in v25.12.2.
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y

# Disable zram-swap (4GB RAM) and irqbalance (1:1 IRQ/XPS + WAN RPS in n3160-tune)
# CONFIG_PACKAGE_zram-swap is not set
# CONFIG_PACKAGE_irqbalance is not set

# Strip unused wired, virtual, and USB NIC drivers from x86/64 defaults
# CONFIG_PACKAGE_kmod-e1000 is not set
# CONFIG_PACKAGE_kmod-e1000e is not set
# CONFIG_PACKAGE_kmod-i40e is not set
# CONFIG_PACKAGE_kmod-igbvf is not set
# CONFIG_PACKAGE_kmod-igc is not set
# CONFIG_PACKAGE_kmod-ixgbe is not set
# CONFIG_PACKAGE_kmod-ixgbevf is not set
# CONFIG_PACKAGE_kmod-pcnet32 is not set
# CONFIG_PACKAGE_kmod-dwmac-intel is not set
# CONFIG_PACKAGE_kmod-r8101 is not set
# CONFIG_PACKAGE_kmod-r8125 is not set
# CONFIG_PACKAGE_kmod-r8126 is not set
# CONFIG_PACKAGE_kmod-r8127 is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-r8169 is not set
# CONFIG_PACKAGE_kmod-bnx2 is not set
# CONFIG_PACKAGE_kmod-tg3 is not set
# CONFIG_PACKAGE_kmod-8139cp is not set
# CONFIG_PACKAGE_kmod-8139too is not set
# CONFIG_PACKAGE_kmod-forcedeth is not set
# CONFIG_PACKAGE_kmod-via-rhine is not set
# CONFIG_PACKAGE_kmod-via-velocity is not set
# CONFIG_PACKAGE_kmod-tulip is not set
# CONFIG_PACKAGE_kmod-amazon-ena is not set
# CONFIG_PACKAGE_kmod-amd-xgbe is not set
# CONFIG_PACKAGE_kmod-vmxnet3 is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-net-asix is not set
# CONFIG_PACKAGE_kmod-usb-net-asix-ax88179 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8150 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor is not set

# Strip Wi-Fi / wireless kernel stack, userland tools, and AP/STA daemons
# (Note: libiwinfo and rpcd-mod-iwinfo are hard deps of LuCI status/network
# modules and contain no wireless kernel drivers.)
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iw-full is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
# CONFIG_PACKAGE_wpad-mini is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_hostapd-basic is not set
# CONFIG_PACKAGE_hostapd-basic-openssl is not set
# CONFIG_PACKAGE_hostapd-openssl is not set
# CONFIG_PACKAGE_wpa-supplicant is not set
# CONFIG_PACKAGE_wpa-supplicant-openssl is not set

# ------------------------------------------------------------------------------
# 4. PPPoE & IPv6 Stack
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ------------------------------------------------------------------------------
# 5. Router Plugins & Features
# ------------------------------------------------------------------------------
# Wake-on-LAN
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# KMS Server
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# UPnP (strictly nftables backend, forbid iptables backend)
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# Dynamic DNS (ddns-scripts; forbid luci-app-ddns-go)
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_bind-host=y
CONFIG_PACKAGE_openssl-util=y
# CONFIG_PACKAGE_luci-app-ddns-go is not set

# [Customizable] Additional verified domestic DDNS providers in v25.12.2:
# CONFIG_PACKAGE_ddns-scripts-dnspod=y      # DNSPod legacy API
# CONFIG_PACKAGE_ddns-scripts-dnspod-v3=y   # Tencent Cloud DNSPod API v3 (recommended)
# CONFIG_PACKAGE_ddns-scripts-huaweicloud=y # Huawei Cloud DNS
# CONFIG_PACKAGE_ddns-scripts-cnkuai=y      # CnKuai DNS

# ZeroTier
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ------------------------------------------------------------------------------
# 6. LuCI Web Interface, HTTPS & Themes
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ------------------------------------------------------------------------------
# 7. Operations & Diagnostic Utilities
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_htop=y
# Full Normal build of Vim (Tiny "vim" package is explicitly disabled to avoid conflicts)
CONFIG_PACKAGE_vim-full=y
# CONFIG_PACKAGE_vim is not set
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_bind-dig=y
