#!/bin/sh /etc/rc.common
# Hardware & network queue tuning for Intel N3160 + I210 (kmod-igb).
# Runs at START=19 (after kmod-igb load, before S20network brings links UP)
# so Ring/EEE changes never drop an active WAN/PPPoE link, and reloads
# idempotently on network/interface.* events to apply IRQ, XPS, and WAN RPS.

# shellcheck disable=SC2034
START=19
# shellcheck disable=SC2034
USE_PROCD=1

# ==============================================================================
# [Customizable] Leave WAN_IF empty to auto-detect from UCI (network.wan.device),
# or explicitly set e.g. WAN_IF="eth0" or WAN_IF="eth1" to override.
# ==============================================================================
WAN_IF=""
RING_SIZE=1024
WAN_RPS_CPUS="e"

log_msg() {
  if command -v logger >/dev/null 2>&1; then
    logger -t n3160-tune "$1"
  fi
}

set_schedutil_governor() {
  for _gov_dir in /sys/devices/system/cpu/cpufreq/policy* /sys/devices/system/cpu/cpu*/cpufreq; do
    [ -d "$_gov_dir" ] || continue
    [ -f "${_gov_dir}/scaling_available_governors" ] || continue
    [ -w "${_gov_dir}/scaling_governor" ] || continue
    if grep -qw "schedutil" "${_gov_dir}/scaling_available_governors" 2>/dev/null; then
      _cur_gov="$(cat "${_gov_dir}/scaling_governor" 2>/dev/null || true)"
      if [ "$_cur_gov" != "schedutil" ]; then
        printf 'schedutil\n' > "${_gov_dir}/scaling_governor" 2>/dev/null || true
      fi
    fi
  done
}

find_igb_interfaces() {
  _fii_list=""
  for _net_path in /sys/class/net/*; do
    [ -e "$_net_path" ] || continue
    [ -L "${_net_path}/device/driver" ] || continue
    _drv_path="$(readlink "${_net_path}/device/driver" 2>/dev/null || true)"
    [ "${_drv_path##*/}" = "igb" ] || continue
    _iface="${_net_path##*/}"
    _fii_list="${_fii_list}${_fii_list:+ }${_iface}"
  done
  printf '%s\n' "$_fii_list"
}

resolve_wan_if() {
  if [ -n "$WAN_IF" ]; then
    if [ -d "/sys/class/net/$WAN_IF" ]; then
      printf '%s\n' "$WAN_IF"
      return 0
    fi
    log_msg "Configured WAN_IF=${WAN_IF} not found in /sys/class/net"
    return 1
  fi

  if command -v uci >/dev/null 2>&1; then
    _rw_raw="$(uci -q get network.wan.device 2>/dev/null || true)"
    [ -n "$_rw_raw" ] || _rw_raw="$(uci -q get network.wan.ifname 2>/dev/null || true)"
    _rw_first="$(printf '%s\n' "$_rw_raw" | awk '{print $1}')"
    _rw_base="${_rw_first%%.*}"
    if [ -n "$_rw_base" ] && [ ! -d "/sys/class/net/${_rw_base}/device" ]; then
      for _rw_lower in "/sys/class/net/${_rw_base}"/lower_*; do
        if [ -e "$_rw_lower" ]; then
          _rw_base="${_rw_lower##*/lower_}"
          break
        fi
      done
    fi
    if [ -n "$_rw_base" ] && [ -d "/sys/class/net/${_rw_base}/device" ]; then
      printf '%s\n' "$_rw_base"
      return 0
    fi
  fi

  return 1
}

tune_igb_rings_and_eee() {
  _tire_devs="$1"
  command -v ethtool >/dev/null 2>&1 || return 0

  for _dev in $_tire_devs; do
    _cur_rx="$(ethtool -g "$_dev" 2>/dev/null | awk '/^Current hardware settings:/ {cur=1; next} cur && /^RX:/ {print $2; exit}')"
    _cur_tx="$(ethtool -g "$_dev" 2>/dev/null | awk '/^Current hardware settings:/ {cur=1; next} cur && /^TX:/ {print $2; exit}')"
    if [ -n "$_cur_rx" ] && [ -n "$_cur_tx" ]; then
      if [ "$_cur_rx" != "$RING_SIZE" ] || [ "$_cur_tx" != "$RING_SIZE" ]; then
        ethtool -G "$_dev" rx "$RING_SIZE" tx "$RING_SIZE" 2>/dev/null || true
      fi
    fi
    if ethtool --show-eee "$_dev" 2>/dev/null | grep -q "EEE status: enabled"; then
      ethtool --set-eee "$_dev" eee off 2>/dev/null || true
    fi
  done
}

pin_queue_irq() {
  _pqi_dev="$1"
  _pqi_q="$2"
  _pqi_cpu="$3"
  _pqi_irq="$(awk -v p1="${_pqi_dev}-TxRx-${_pqi_q}" -v p2="${_pqi_dev}-rx-${_pqi_q}" '
    $NF == p1 || $NF == p2 {
      sub(/:$/, "", $1)
      print $1
      exit
    }
  ' /proc/interrupts 2>/dev/null)"

  if [ -n "$_pqi_irq" ] && [ -w "/proc/irq/${_pqi_irq}/smp_affinity_list" ]; then
    _pqi_cur="$(cat "/proc/irq/${_pqi_irq}/smp_affinity_list" 2>/dev/null || true)"
    if [ "$_pqi_cur" != "$_pqi_cpu" ]; then
      printf '%s\n' "$_pqi_cpu" > "/proc/irq/${_pqi_irq}/smp_affinity_list" 2>/dev/null || true
    fi
  fi
}

set_queue_xps() {
  _sqx_dev="$1"
  _sqx_q="$2"
  _sqx_cpu="$3"
  _sqx_file="/sys/class/net/${_sqx_dev}/queues/tx-${_sqx_q}/xps_cpus"
  if [ -w "$_sqx_file" ] && [ "$_sqx_cpu" -ge 0 ] && [ "$_sqx_cpu" -lt 32 ]; then
    _sqx_mask="$(printf '%x' "$((1 << _sqx_cpu))")"
    printf '%s\n' "$_sqx_mask" > "$_sqx_file" 2>/dev/null || true
  fi
}

set_queue_rps() {
  _sqr_qdir="$1"
  _sqr_cpus="$2"
  _sqr_flow="$3"
  if [ -w "${_sqr_qdir}/rps_cpus" ]; then
    printf '%s\n' "$_sqr_cpus" > "${_sqr_qdir}/rps_cpus" 2>/dev/null || true
  fi
  if [ -w "${_sqr_qdir}/rps_flow_cnt" ]; then
    printf '%s\n' "$_sqr_flow" > "${_sqr_qdir}/rps_flow_cnt" 2>/dev/null || true
  fi
}

tune_queues_and_rps() {
  _tqr_devs="$1"
  _tqr_wan="$2"
  _tqr_cpus="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"

  [ "$_tqr_cpus" -ge 2 ] || return 0

  # Keep global RFS disabled (0 benefit for routed traffic; avoids socket table lookups).
  if [ -w /proc/sys/net/core/rps_sock_flow_entries ]; then
    _cur_rfs="$(cat /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null || true)"
    if [ "$_cur_rfs" != "0" ]; then
      printf '0\n' > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null || true
    fi
  fi

  # Align TxRx-q IRQ and tx-q XPS 1:1 on CPU (q % ncpus) across WAN and LAN ports
  # so TX enqueue and TX completion/BQL cleanup always stay on the same core.
  for _dev in $_tqr_devs; do
    for _txdir in "/sys/class/net/${_dev}/queues"/tx-*; do
      [ -d "$_txdir" ] || continue
      _q="${_txdir##*/tx-}"
      case "$_q" in
        ''|*[!0-9]*) continue ;;
      esac
      _cpu="$((_q % _tqr_cpus))"
      pin_queue_irq "$_dev" "$_q" "$_cpu"
      set_queue_xps "$_dev" "$_q" "$_cpu"
    done

    for _rxdir in "/sys/class/net/${_dev}/queues"/rx-*; do
      [ -d "$_rxdir" ] || continue
      if [ "$_dev" = "$_tqr_wan" ] && [ "${_rxdir##*/}" = "rx-0" ]; then
        set_queue_rps "$_rxdir" "$WAN_RPS_CPUS" "0"
      else
        set_queue_rps "$_rxdir" "0" "0"
      fi
    done
  done
}

start_service() {
  set_schedutil_governor
  _igb_devs="$(find_igb_interfaces)"
  if [ -n "$_igb_devs" ]; then
    tune_igb_rings_and_eee "$_igb_devs"
  fi
  reload_service
}

reload_service() {
  _igb_devs="$(find_igb_interfaces)"
  _resolved_wan="$(resolve_wan_if || true)"
  if [ -n "$_igb_devs" ]; then
    tune_queues_and_rps "$_igb_devs" "$_resolved_wan"
  fi
  log_msg "Applied tuning (igb='${_igb_devs:-none}', wan='${_resolved_wan:-none}', ring=${RING_SIZE})"
}

service_triggers() {
  procd_add_reload_trigger "network"
  procd_add_raw_trigger "interface.*" 1000 /etc/init.d/n3160-tune reload
}
