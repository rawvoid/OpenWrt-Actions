# Device profile metadata for n3160-i210
# Sourced by GitHub Actions workflows and repository validation scripts.

DEVICE_NAME="n3160-i210"
DEVICE_TITLE="Intel N3160 / I210 Wired Router"

# Upstream source selection (supports future multi-flavor expansion)
UPSTREAM_FLAVOR="immortalwrt"
UPSTREAM_REPO="https://github.com/immortalwrt/immortalwrt.git"
UPSTREAM_REF="v25.12.2"

# Output path under openwrt/bin/targets/ and firmware file matching glob
TARGET_DIR="x86/64"
ARTIFACT_GLOB="*squashfs-combined-efi.img.gz"

# Package manager used by the target baseline ("apk" for 25.12+, "opkg" for legacy)
PKG_MANAGER="apk"

# Optional device hooks supported by build.yml (create alongside this file if needed):
# - feeds.conf.append : Extra feed lines appended before ./scripts/feeds update
# - pre-defconfig.sh  : Runs in openwrt/ after copying seed.config and before make defconfig
# - verify.sh         : Fail-Fast .config check executed right after make defconfig
